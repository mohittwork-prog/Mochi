{
  "name": "mochi-widget",
  "productName": "Mochi",
  "version": "0.2.5",
  "description": "A desktop cat that floats above your apps and types when you type.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --mac dmg --arm64 --publish never && electron-builder --mac dmg --x64 --publish never"
  },
  "dependencies": {
    "uiohook-napi": "^1.5.4"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.mochi.widget",
    "mac": {
      "category": "public.app-category.entertainment",
      "target": "dmg",
      "extendInfo": {
        "LSUIElement": true,
        "NSAppleEventsUsageDescription": "Mochi watches your typing so the cat can type along."
      },
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist"
    },
    "files": [
      "main.js",
      "preload.js",
      "settings-preload.js",
      "widget.html",
      "settings.html",
      "trayTemplate.png",
      "trayTemplate@2x.png"
    ],
    "dmg": {
      "title": "Mochi ${arch}",
      "contents": [
        {
          "x": 140,
          "y": 160
        },
        {
          "x": 400,
          "y": 160,
          "type": "link",
          "path": "/Applications"
        }
      ],
      "artifactName": "Mochi-${arch}.dmg"
    },
    "npmRebuild": false,
    "asarUnpack": [
      "node_modules/uiohook-napi/**"
    ],
    "afterSign": "scripts/after-sign.js"
  }
}