{
  "name": "mochi-widget",
  "productName": "Mochi",
  "version": "0.1.0",
  "description": "A desktop cat that floats above your apps and types when you type.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "postinstall": "electron-builder install-app-deps",
    "dist": "electron-builder --mac dmg --arm64 --x64 --publish never"
  },
  "dependencies": {
    "uiohook-napi": "^1.5.4"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.mochi.widget",
    "mac": {
      "category": "public.app-category.entertainment",
      "target": "dmg",
      "identity": "-",
      "extendInfo": {
        "LSUIElement": true,
        "NSAppleEventsUsageDescription": "Mochi watches your typing so the cat can type along."
      }
    },
    "files": [
      "main.js",
      "preload.js",
      "widget.html",
      "trayTemplate.png",
      "trayTemplate@2x.png"
    ],
    "dmg": {
      "title": "Mochi",
      "contents": [
        {
          "x": 140,
          "y": 160
        },
        {
          "x": 400,
          "y": 160,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  }
}